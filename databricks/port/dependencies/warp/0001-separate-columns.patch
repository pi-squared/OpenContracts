+def _ruled_table_side_gutters(page, words):
+    """Keep an independently ruled table separate from an adjacent text panel.
+
+    Table borders supply the region boundary; internal cell gutters are never
+    used as layout gutters. Require text at the table's vertical level and a
+    clear gap outside its enclosing rectangle, rather than guessing from rows.
+    """
+    candidates = []
+    tables = page.find_tables()
+    for table in tables:
+        x0, top, x1, bottom = table.bbox
+        # A detected subtable inside an enclosing ruled form/table is not an
+        # independent panel: its outside words can be other cells of that table.
+        if any(
+            other is not table
+            and other.bbox[0] <= x0 + 1
+            and other.bbox[1] <= top + 1
+            and other.bbox[2] >= x1 - 1
+            and other.bbox[3] >= bottom - 1
+            and (other.bbox[2] - other.bbox[0]) * (other.bbox[3] - other.bbox[1])
+                > 1.2 * (x1 - x0) * (bottom - top)
+            for other in tables
+        ):
+            continue
+        if x1 - x0 < COL_MIN_WIDTH_FRACTION * page.width:
+            continue
+        aligned = [w for w in words if top <= w["top"] < bottom]
+        for side in ("left", "right"):
+            outside = [w for w in aligned if
+                       (w["x1"] < x0 if side == "left" else w["x0"] > x1)]
+            if len(_group_words_into_lines(outside)) < 2:
+                continue
+            gutter = ((max(w["x1"] for w in outside), x0) if side == "left"
+                      else (x1, min(w["x0"] for w in outside)))
+            if gutter[1] - gutter[0] >= COL_GUTTER_MIN_WIDTH_FRACTION * page.width:
+                candidates.append(gutter)
+    return [max(candidates, key=lambda g: g[1] - g[0])] if candidates else []
+
